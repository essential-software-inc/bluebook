{
  "name": "note-builder",
  "version": "3.2.9",
  "private": true,
  "description": "Note Builder — wrapped as an iOS/Android app with Capacitor",
  "scripts": {
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:doctor": "cap doctor",
    "capacitor:sync:before": "python3 scripts/patch-ad-attest-client.py --skip-missing www/index.html",
    "capacitor:sync:after": "python3 scripts/add-play-integrity.py"
  },
  "dependencies": {
    "@capacitor/core": "8.6.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/inappbrowser": "4.1.0",
    "@capacitor/share": "8.0.3",
    "@southdevs/capacitor-google-auth": "7.0.0",
    "@revenuecat/purchases-capacitor": "15.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "8.6.3",
    "@capacitor/ios": "8.6.3",
    "@capacitor/android": "8.6.3",
    "typescript": "^5.9.0"
  }
}
